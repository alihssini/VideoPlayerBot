# https://my.telegram.org -> API development tools
API_ID=12345
API_HASH=abc123
# optional, otherwise asked at login (international format)
PHONE_NUMBER=+49123456789
# root owners (besides the logged-in account): bot owners that no command can remove, space separated.
# All other roles (bot owners, group owners, SUDO users) are managed with commands and stored in data/acl/*.json.
OWNER_USERS=123
# optional, only read once: moved to data/acl/global_sudo.json on the first start, then removed from here
# SUDO_USERS=123 356 789
# optional text auto-reply for private messages (leave empty to disable)
REPLY_MESSAGE=
# video quality: SD_360p (default, 1 core), SD_480p, HD_720p (2+ cores), FHD_1080p
VIDEO_QUALITY=SD_360p
# YouTube videos: stream (default: video + audio straight from YouTube, nothing downloaded,
# falls back to downloading when YouTube refuses the stream) or download (the whole video first, steadier)
YOUTUBE_VIDEO_MODE=stream
# refuse files bigger than this many MB (downloads and /download uploads), default 1000
DOWNLOAD_MAX_MB=1000
# name searches skip results longer than this many minutes, default 15
SEARCH_MAX_MINUTES=15
# optional: session file name and folder, defaults user / sessions
# SESSION_NAME=user
# SESSION_DIR=sessions

# Max items waiting in the play queue of one group (default 10)
MAX_QUEUE=10

# Seconds between updates of the progress bar on the now-playing card (default 10)
PROGRESS_EVERY=10

# Lyrics videos (/lyrics): songs longer than this many minutes play without lyrics (default 15)
LYRICS_MAX_MINUTES=15
# the length of the found lyrics may differ from the song by this many seconds (default 10)
LYRICS_TOLERANCE=10
# font used for the lyrics (must contain the letters you need; default Vazirmatn = Latin + Persian/Arabic)
# LYRICS_FONT=Vazirmatn
# lyrics are fetched from LRCLIB; only change this for a self-hosted instance
# LRCLIB_URL=https://lrclib.net/api

# leave the voice chat when nobody else listened this many minutes (0 = never, default 10)
AUTO_LEAVE_MINUTES=10
# /play and /download requests one user may run at the same time (default 2, bot owners unlimited)
USER_PARALLEL=2

# optional: a real bot (token from @BotFather) posts the now-playing card WITH buttons (pause, next, stop, loop, volume, queue).
# Add the bot to the groups (it needs to send messages); in private chats it can only post after the user sent /start to the bot.
# Without it (or where it cannot post) the account posts the card without buttons.
BOT_TOKEN=
